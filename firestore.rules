rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function assignedHospital() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.hospitaisSelecionados.hasAny([resource.data.nome_hospital]);
    }

    match /dashboard_public/{document=**} {
      allow read: if true;
      allow write: if admin();
    }

    match /hospitais/{hospitalId} {
      allow read: if admin() || assignedHospital();
      allow write: if admin();
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create, delete: if admin();
      allow update: if admin() || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['acessos', 'chaveauth', 'hospitalAtivo'])
      );
    }

    match /temporaryPatients/{document=**} {
      allow read, delete: if admin() || (
        signedIn() && resource.data.email == request.auth.token.email
      );
      allow create: if admin() || (
        signedIn() && request.resource.data.email == request.auth.token.email
      );
      allow update: if admin() || (
        signedIn() &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.email == request.auth.token.email
      );
    }

    match /testPatients/{patientId} {
      allow read, delete: if admin() || (
        signedIn() && resource.data.createdBy == request.auth.uid
      );
      allow create: if admin() || (
        signedIn() && request.resource.data.createdBy == request.auth.uid
      );
      allow update: if admin() || (
        signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid
      );
    }

    match /logs/{logId} {
      allow read, update, delete: if admin();
      allow create: if signedIn();
    }

    match /user_tracking/{document=**} {
      allow read, write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
